<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>线上商城 - 订单管理系统</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft Yahei", sans-serif;
        }
        body {
            background-color: #f4f6f9;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        h1 {
            color: #2c3e50;
            margin-bottom: 20px;
            text-align: center;
        }
        .stat-box {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }
        .stat-card {
            flex:1;
            background: #fff;
            padding:16px;
            border-radius:10px;
            box-shadow: 0 2px 8px #00000014;
            text-align:center;
        }
        .stat-card h3 {
            font-size:24px;
            margin:8px 0;
            color:#3498db;
        }
        .search-bar {
            background:#fff;
            padding:16px;
            border-radius:10px;
            box-shadow: 0 2px 8px #00000014;
            display:flex;
            gap:12px;
            align-items:center;
            margin-bottom:20px;
        }
        input, select, button {
            padding:8px 12px;
            border:1px solid #ddd;
            border-radius:6px;
            font-size:14px;
        }
        button {
            cursor:pointer;
            border:none;
            background:#3498db;
            color:white;
        }
        button.success {background:#27ae60;}
        button.danger {background:#e74c3c;}
        table {
            width:100%;
            background:#fff;
            border-radius:10px;
            box-shadow:0 2px 8px #00000014;
            border-collapse: collapse;
            overflow:hidden;
        }
        th,td {
            padding:12px 16px;
            text-align:center;
            border-bottom:1px solid #eee;
        }
        th {
            background:#2c3e50;
            color:white;
        }
        .modal {
            display:none;
            position:fixed;
            top:0;left:0;
            width:100%;height:100%;
            background:rgba(0,0,0,0.4);
            align-items:center;
            justify-content:center;
        }
        .modal-content {
            background:#fff;
            padding:24px;
            border-radius:10px;
            width:420px;
        }
        .modal-content h3 {margin-bottom:16px;}
        .form-item {margin-bottom:12px;}
        .form-item label {display:block;margin-bottom:4px;}
        .modal-footer {
            display:flex;
            gap:10px;
            justify-content:flex-end;
            margin-top:16px;
        }
        .status-wait {color:#f39c12;}
        .status-send {color:#3498db;}
        .status-finish {color:#27ae60;}
    </style>
</head>
<body>
    <div class="container">
        <h1>线上商城订单管理系统</h1>
        <!-- 统计面板 -->
        <div class="stat-box">
            <div class="stat-card">
                <p>全部订单</p>
                <h3 id="total">0</h3>
            </div>
            <div class="stat-card">
                <p>待付款</p>
                <h3 id="waitPay">0</h3>
            </div>
            <div class="stat-card">
                <p>待发货</p>
                <h3 id="waitSend">0</h3>
            </div>
            <div class="stat-card">
                <p>已完成</p>
                <h3 id="finished">0</h3>
            </div>
        </div>
        <!-- 搜索栏 -->
        <div class="search-bar">
            <input type="text" id="searchKey" placeholder="输入订单号搜索">
            <select id="filterStatus">
                <option value="">全部状态</option>
                <option value="待付款">待付款</option>
                <option value="待发货">待发货</option>
                <option value="已完成">已完成</option>
            </select>
            <button onclick="searchOrder()">搜索</button>
            <button class="success" onclick="openAddModal()">新增订单</button>
        </div>
        <!-- 订单表格 -->
        <table>
            <thead>
                <tr>
                    <th>订单编号</th>
                    <th>客户名称</th>
                    <th>商品名称</th>
                    <th>金额(元)</th>
                    <th>下单时间</th>
                    <th>订单状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="orderTbody">
            </tbody>
        </table>
    </div>

    <!-- 新增订单弹窗 -->
    <div class="modal" id="addModal">
        <div class="modal-content">
            <h3>新增订单</h3>
            <div class="form-item">
                <label>客户名称</label>
                <input id="custName">
            </div>
            <div class="form-item">
                <label>商品名称</label>
                <input id="goodsName">
            </div>
            <div class="form-item">
                <label>订单金额</label>
                <input type="number" id="orderPrice">
            </div>
            <div class="form-item">
                <label>订单状态</label>
                <select id="orderStatus">
                    <option>待付款</option>
                    <option>待发货</option>
                    <option>已完成</option>
                </select>
            </div>
            <div class="modal-footer">
                <button onclick="closeAddModal()">取消</button>
                <button class="success" onclick="addOrder()">确认添加</button>
            </div>
        </div>
    </div>

<script>
    // 初始模拟订单数据
    let orderList = [
        {oid:"ORD20261001",cust:"张三",goods:"无线蓝牙耳机",price:199,time:"2026-10-01 14:20",status:"待付款"},
        {oid:"ORD20261002",cust:"李四",goods:"机械键盘",price:299,time:"2026-10-02 09:10",status:"待发货"},
        {oid:"ORD20261003",cust:"王五",goods:"智能手表",price:899,time:"2026-10-03 16:45",status:"已完成"}
    ];
    let showList = [...orderList];

    // 渲染表格
    function renderTable(){
        const tbody = document.getElementById("orderTbody");
        tbody.innerHTML = "";
        showList.forEach(item=>{
            let cls = "";
            if(item.status === "待付款") cls="status-wait";
            else if(item.status === "待发货") cls="status-send";
            else cls="status-finish";
            tbody.innerHTML += `
                <tr>
                    <td>${item.oid}</td>
                    <td>${item.cust}</td>
                    <td>${item.goods}</td>
                    <td>${item.price}</td>
                    <td>${item.time}</td>
                    <td class="${cls}">${item.status}</td>
                    <td>
                        <button onclick="changeStatus('${item.oid}')">修改状态</button>
                        <button class="danger" onclick="delOrder('${item.oid}')">删除</button>
                    </td>
                </tr>
            `
        })
        countStat();
    }

    // 统计数据
    function countStat(){
        document.getElementById("total").innerText = orderList.length;
        document.getElementById("waitPay").innerText = orderList.filter(x=>x.status==="待付款").length;
        document.getElementById("waitSend").innerText = orderList.filter(x=>x.status==="待发货").length;
        document.getElementById("finished").innerText = orderList.filter(x=>x.status==="已完成").length;
    }

    //搜索
    function searchOrder(){
        const key = document.getElementById("searchKey").value.trim().toLowerCase();
        const s = document.getElementById("filterStatus").value;
        showList = orderList.filter(item=>{
            let matchKey = item.oid.toLowerCase().includes(key);
            let matchSt = s === "" || item.status === s;
            return matchKey && matchSt;
        })
        renderTable();
    }

    //新增弹窗
    function openAddModal(){
        document.getElementById("addModal").style.display="flex";
    }
    function closeAddModal(){
        document.getElementById("addModal").style.display="none";
    }
    function addOrder(){
        const cust = document.getElementById("custName").value.trim();
        const goods = document.getElementById("goodsName").value.trim();
        const price = Number(document.getElementById("orderPrice").value);
        const status = document.getElementById("orderStatus").value;
        if(!cust || !goods || !price){
            alert("信息不能为空");
            return;
        }
        const now = new Date();
        const timeStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
        const newOid = "ORD"+Date.now().toString().slice(-8);
        orderList.push({oid:newOid,cust,goods,price,time:timeStr,status});
        closeAddModal();
        searchOrder();
    }

    //修改状态
    function changeStatus(oid){
        const item = orderList.find(x=>x.oid === oid);
        const arr = ["待付款","待发货","已完成"];
        let idx = arr.indexOf(item.status);
        idx = (idx+1)%3;
        item.status = arr[idx];
        searchOrder();
    }

    //删除订单
    function delOrder(oid){
        if(confirm("确定删除该订单？")){
            orderList = orderList.filter(x=>x.oid!==oid);
            searchOrder();
        }
    }

    //初始化渲染
    renderTable();
</script>
</body>
</html>
